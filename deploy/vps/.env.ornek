# ─────────────────────────────────────────────────────────────────────────────
# VegaLand — VPS ORTAM DEĞİŞKENİ ŞABLONU (GERÇEK DEĞER YOK, GİZLİ BİLGİ YOK)
#
# Bu dosya İKİ hedef dosyanın şablonunu birlikte tutar. `kur.sh` bu dosyayı
# bölüm işaretlerine göre böler ve EKSİK olanları iskelet olarak oluşturur:
#
#     dashboard/.env.local   ← geo + notlandırma + hasat DB bağlantısı BURADAN okunur
#     scraper/.env           ← Telegram / Supabase / Census anahtarları
#
# ⚠ NEDEN dashboard/.env.local: scraper/grade-offmarket.mjs içindeki dbUrl()
#   DATABASE_URL'i doğrudan `../dashboard/.env.local` dosyasından okur. O dosya
#   yoksa geo turu ve notlandırma ilk saniyede patlar.
#
# ⚠ Bu şablonu KOPYALAYIP doldur; gerçek değerleri buraya YAZMA (repoda durur).
#   Değerleri Mac'teki dosyalardan al:
#       ~/Desktop/Aktif\ Projeler/terralot-v2/dashboard/.env.local
#       ~/Desktop/Aktif\ Projeler/terralot-v2/scraper/.env
#   Aktarırken scp/rsync KULLANMA gerekirse tek seferlik `scp` yeterli, ama
#   tercih: VPS'te `nano` ile elle yapıştır (dosya diskte tek yerde kalsın).
#
# DOSYA İZNİ: kur.sh her ikisini de `chmod 600` yapar.
# ─────────────────────────────────────────────────────────────────────────────

### ===== dashboard/.env.local =====
# Postgres (Supabase). GEO + NOTLANDIRMA + HASAT bunu kullanır — ZORUNLU.
# Kaynak: Supabase → Project Settings → Database → Connection string (URI).
# Not: dbUrl() bu değeri okurken "aws-0-" → "aws-1-" çevirir ve
# "?pgbouncer=true..." kuyruğunu atar; havuzlu (pooler) URI vermen sorun değil.
DATABASE_URL=

# Migration / doğrudan bağlantı (pooler'ı atlayan port 5432 URI'si).
DIRECT_URL=

# Supabase — hasat-runner satır sayımı ve migrate_to_supabase.js için ZORUNLU.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Aşağıdakiler VPS'te GEREKLİ DEĞİL (panel Vercel'de koşuyor). Boş bırakılabilir.
#    Sadece dosya paneldeki .env.local ile birebir tutulmak istenirse doldurulur.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_PASSWORD=
SESSION_SECRET=
REGRID_API_TOKEN=
ATTOM_API_KEY=
LOB_API_KEY=

### ===== scraper/.env =====
# Telegram bildirimleri — BOŞSA bildirim gitmez, tur sessizce koşar.
# ⚠ 2026-07-30 durumu: Mac'te bu iki alan BOŞ. VPS 7/24 koşacağı için burayı
#   doldurmak ÖNEMLİ: aksi halde gece patlayan bir turu sabaha kadar kimse görmez.
#   Token: Telegram'da @BotFather → /newbot. Chat ID: bota mesaj at, sonra
#   https://api.telegram.org/bot<TOKEN>/getUpdates çıktısındaki chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase (migrate_to_supabase.js) — service_role, GİZLİ.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# US Census API (ilçe demografisi). Boşsa demografi tazelemesi atlanır.
# Ücretsiz: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# RapidAPI (Zillow) — ÜCRETLİ. VPS'te turu SKIP_ZILLOW=1 ile koşuyoruz,
# yani bu anahtar GEREKMEZ. Boş bırak; boş kalması kazadan korur.
RAPIDAPI_KEY=

# Fiyat düşüş alarmı eşiği (yüzde).
PRICE_DROP_THRESHOLD=10
