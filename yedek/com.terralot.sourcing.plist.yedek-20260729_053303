  <string>/Users/yigiterturk/Library/Application Support/terralot-runner/logs/launchd.err.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/yigiterturk/Library/Application Support/terralot-runner</string>
</dict>
</plist>
