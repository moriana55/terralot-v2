<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.terralot.sourcing</string>
  <!-- Desktop TCC engeli nedeniyle proje kopyası ~/Library/Application Support/terralot-runner altında koşar (bkz. run.sh başlığı) -->
